# Absolute path to your Obsidian vault directory
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Port and host to bind the HTTP / SSE server
PORT=3000
HOST=0.0.0.0

# Secret Bearer Token / API Key for remote access (required for tunnel/web requests)
AUTH_TOKEN=your-super-secret-token-here

# Daily notes subfolder within your vault (default: "Daily Notes")
DAILY_NOTES_FOLDER=Daily Notes

# Daily notes date format (default: "YYYY-MM-DD")
DAILY_NOTES_FORMAT=YYYY-MM-DD

# Folder inside the vault for safe backup snapshots before patch/overwrite (default: ".trash")
TRASH_FOLDER=.trash

# Transport mode: "http" (default for web/tunnel) or "stdio" (for local CLI/desktop tools)
TRANSPORT_MODE=http
